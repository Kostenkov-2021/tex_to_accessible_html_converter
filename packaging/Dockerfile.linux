# syntax=docker/dockerfile:1
ARG LINUX_IMAGE=ubuntu:24.04
FROM ${LINUX_IMAGE} AS test
ARG PYTHON_LIBRARY=libpython3.12
ENV DEBIAN_FRONTEND=noninteractive PYTHONUTF8=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-wxgtk4.0 xvfb xauth binutils \
    texlive-latex-extra texlive-luatex texlive-xetex texlive-lang-cyrillic \
    texlive-fonts-recommended cm-super \
    && rm -rf /var/lib/apt/lists/*
RUN /usr/bin/python3 -m venv --system-site-packages /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir 'pyinstaller>=6.22' 'pytest>=8'
RUN apt-get update && apt-get install -y --no-install-recommends texlive-extra-utils \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends ${PYTHON_LIBRARY} \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/venv/bin:${PATH}" PYTHON=/opt/venv/bin/python
WORKDIR /app
COPY tex_to_accessible_html_converter/ tex_to_accessible_html_converter/
COPY packaging/*.py packaging/*.sh packaging/*.spec packaging/
COPY pytest.ini LICENSE ./
COPY docs/README.html docs/README_RU.html docs/
COPY scripts/check_tex_integration.py scripts/
COPY tests/fixtures/integration.tex tests/fixtures/
RUN python packaging/compile_translations.py && python -m pytest -q
RUN bash packaging/prepare_tex_fonts.sh tests/fixtures/integration.tex \
    && python scripts/check_tex_integration.py --engine lualatex \
    && python scripts/check_tex_integration.py --engine latex \
    && python scripts/check_tex_integration.py --engine xelatex

FROM test AS build
# Unit tests already passed in the parent layer with these exact sources.
RUN SKIP_TESTS=1 bash packaging/build_linux.sh

# Verify the binaries without the build Python, wxPython or source tree.
FROM ${LINUX_IMAGE} AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-0t64 libgl1 libx11-6 libsm6 xvfb xauth \
    texlive-latex-extra texlive-luatex texlive-xetex texlive-lang-cyrillic \
    texlive-fonts-recommended cm-super \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends texlive-extra-utils \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends \
    librsvg2-common shared-mime-info && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/dist/linux/TeXToAccessibleHTML /opt/TeXToAccessibleHTML
RUN /opt/TeXToAccessibleHTML/TeXToAccessibleHTMLCLI --help
WORKDIR /work
ENTRYPOINT ["/opt/TeXToAccessibleHTML/TeXToAccessibleHTMLCLI"]

FROM runtime AS verify
COPY packaging/smoke_linux_gui.sh /tmp/smoke_linux_gui.sh
COPY tests/fixtures/integration.tex /fixtures/integration.tex
RUN bash /tmp/smoke_linux_gui.sh /opt/TeXToAccessibleHTML/TeXToAccessibleHTML
RUN for engine in latex lualatex xelatex; do \
      TEXMFVAR=/var/lib/texmf /opt/TeXToAccessibleHTML/TeXToAccessibleHTMLCLI /fixtures/integration.tex \
        --engine "$engine" --tex-distribution texlive --keep logs -o "/work/$engine" \
      && grep -q '<math' "/work/$engine/integration.html" || exit 1; \
    done && mktexlsr /var/lib/texmf
# Root's private font cache must not be needed by an ordinary user.
USER 1000:1000
ENV HOME=/tmp
WORKDIR /tmp
RUN /opt/TeXToAccessibleHTML/TeXToAccessibleHTMLCLI /fixtures/integration.tex \
    --engine lualatex --tex-distribution texlive --keep logs -o /tmp/nonroot-html

# Export only the release files instead of loading the full build image locally.
FROM scratch AS release
COPY --from=build /app/dist/linux/release/ /
