# Only send sources needed by Linux build and integration tests.
*
!pytest.ini
!LICENSE
!tex_to_accessible_html_converter/
!tex_to_accessible_html_converter/*.py
!tex_to_accessible_html_converter/pyproject.toml
!tex_to_accessible_html_converter/locales/
!tex_to_accessible_html_converter/locales/**
!tex_to_accessible_html_converter/tests/
!tex_to_accessible_html_converter/tests/*.py
!tests/
!tests/fixtures/
!tests/fixtures/**
!packaging/
!packaging/*.py
!packaging/*.sh
!packaging/*.spec
!packaging/Dockerfile.linux
!docs/
!docs/README.html
!docs/README_RU.html
!docs/LINUX.md
!scripts/
!scripts/check_tex_integration.py

# Explicit directory exclusions also prevent traversal of restricted host caches.
.git/
.pytest_cache/
.venv/
.venv-build/
.uv-cache/
.ruff_cache/
build/
dist/
conversion_runs/
state/
**/__pycache__/
**/.pytest_cache/
**/conversion_runs/
**/*.html.logs/
**/*.html.temporary/
